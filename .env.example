# Server-Side Google Gemini API Key (used strictly inside api/gemini.js — NEVER expose with VITE_ prefix)
# Add GEMINI_API_KEY in Vercel Project Settings -> Environment Variables (or in .env.local when running `vercel dev`).
GEMINI_API_KEY=

# Supabase Authentication & Real-Time Cloud Sync (safe public client keys)
# Leave blank to run in local-only offline mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
